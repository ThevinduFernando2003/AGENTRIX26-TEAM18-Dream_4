# Gemini API key — powers chat routing, report-review specialists, dynamic
# translation, voice (STT) and prescription OCR. A *paid/billed* key removes the
# free-tier 20-req/day cap; without it those LLM features degrade gracefully to
# heuristics/English/stubs (the app never crashes).
#
# Get a free key: https://aistudio.google.com/apikey
# Then copy this file to project/.env and paste the key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Optional: use OpenAI instead (set LLM_PROVIDER=openai)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_STT_MODEL=whisper-1

# RAG embeddings are LOCAL (ONNX) by default — no key, no quota, and consistent
# across ingest/query, so swapping the key above never requires a re-ingest.
# Set this to "gemini" only if you want Gemini embeddings instead (then re-run
# `python -m project.rag.ingest`, since the vector dimension differs).
RAG_EMBED_BACKEND=local

NTFY_TOPIC_PREFIX=medbridge-demo
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
# Supplier portal uses seeded accounts (see seed_suppliers.json), e.g.
# union / unionpass  ·  nawaloka / nawalokapass
# Legacy global passcode is no longer used.

# Optional Phase 1.6: Postgres instead of local SQLite (CI stays on SQLite).
# DATABASE_URL=postgresql://user:pass@localhost:5432/medbridge
