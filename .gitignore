# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Secrets
project/.env
.env

# SQLite database (generated/seeded at runtime, not source)
project/db/app.db
project/db/*.db-journal
project/db/*.db-wal
project/db/*.db-shm

# Virtual environments
.venv/
venv/
env/

# Streamlit — ignore everything EXCEPT the committed theme (config.toml).
# secrets.toml must never be committed; it lives only in the Cloud Secrets UI.
.streamlit/*
!.streamlit/config.toml

# RAG vector store (generated by `python -m project.rag.ingest`, not source)
project/rag/chroma_store/
chroma_store/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# local run artifact
streamlit_run.log
